#!/usr/bin/env python
# M0/T0.3: the smallest godot-cpp GDExtension that proves the pinned Emscripten
# (tools/emsdk_env.py) can build a side module Godot's web export template can load.
# Not part of the main SConstruct; built and run on its own, out of tree of src/.

env = SConscript("../../godot-cpp/SConstruct", {"api_version": "4.7"})

if env.get("is_msvc", False):
	env["CXXFLAGS"].remove("/std:c++17")
	env["CXXFLAGS"].insert(0, "/std:c++20")
	env["CXXFLAGS"].insert(0, "/Zc:preprocessor")
else:
	env["CXXFLAGS"].remove("-std=c++17")
	env["CXXFLAGS"].insert(0, "-std=c++20")

env.Append(CPPPATH=["src/"])
sources = Glob("src/*.cpp")

library = env.SharedLibrary(
	"bin/libwebsmoke{}{}".format(env["suffix"], env["SHLIBSUFFIX"]),
	source=sources,
)

Default(library)
