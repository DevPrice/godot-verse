[configuration]

entry_symbol = "web_smoke_init"
compatibility_minimum = "4.1"

[libraries]

windows.editor.x86_64 = "res://bin/libwebsmoke.windows.editor.x86_64.dll"
web.release.wasm32 = "res://bin/libwebsmoke.web.template_release.wasm32.nothreads.wasm"
web.debug.wasm32 = "res://bin/libwebsmoke.web.template_debug.wasm32.nothreads.wasm"
