            VhCallVoid(Handle, "set_scroll_offset", array{VhFromVector2(vector2{X := Value, Y := Current.Y})})
        else:
            VhCallVoid(Handle, "set_scroll_offset", array{VhFromVector2(vector2{X := Current.X, Y := Value})})
