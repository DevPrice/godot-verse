    var CellSize<public><getter(CellSizeGetter)><setter(CellSizeSetter)>:vector3 = external {}
    CellSizeGetter<epic_internal>(Accessor:accessor)<transacts>:vector3 = VhToVector3(VhCallValue(Handle, "get_cell_size", array{}))
    CellSizeSetter<epic_internal>(Accessor:accessor, Value:vector3)<transacts>:void = VhCallVoid(Handle, "set_cell_size", array{VhFromVector3(Value)})
    CellSizeGetter<epic_internal>(Accessor:accessor, Field:string)<transacts>:float =
        Current := VhToVector3(VhCallValue(Handle, "get_cell_size", array{}))
        if (Field = "X") then Current.X else if (Field = "Y") then Current.Y else Current.Z
    CellSizeSetter<epic_internal>(Accessor:accessor, Field:string, Value:float)<transacts>:void =
        Current := VhToVector3(VhCallValue(Handle, "get_cell_size", array{}))
        if (Field = "X"):
            VhCallVoid(Handle, "set_cell_size", array{VhFromVector3(vector3{X := Value, Y := Current.Y, Z := Current.Z})})
        else if (Field = "Y"):
            VhCallVoid(Handle, "set_cell_size", array{VhFromVector3(vector3{X := Current.X, Y := Value, Z := Current.Z})})
        else:
            VhCallVoid(Handle, "set_cell_size", array{VhFromVector3(vector3{X := Current.X, Y := Current.Y, Z := Value})})
