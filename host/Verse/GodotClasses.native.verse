    ImageSizeSetter<epic_internal>(Accessor:accessor, Value:vector2)<transacts>:void = VhCallVoid(Handle, "set_image_size", array{VhFromVector2(Value)})
    ImageSizeGetter<epic_internal>(Accessor:accessor, Field:string)<transacts>:float =
        Current := VhToVector2(VhCallValue(Handle, "get_image_size", array{}))
        if (Field = "X") then Current.X else Current.Y
    ImageSizeSetter<epic_internal>(Accessor:accessor, Field:string, Value:float)<transacts>:void =
        Current := VhToVector2(VhCallValue(Handle, "get_image_size", array{}))
        if (Field = "X"):
            VhCallVoid(Handle, "set_image_size", array{VhFromVector2(vector2{X := Value, Y := Current.Y})})
        else:
            VhCallVoid(Handle, "set_image_size", array{VhFromVector2(vector2{X := Current.X, Y := Value})})
    GetBaseTexture<public>()<decides><reads>:texture2d = texture2d[VhObjectFrom[VhCallValueConst(Handle, "get_base_texture", array{})]]
    GetMesh<public>()<decides><reads>:mesh = mesh[VhObjectFrom[VhCallValueConst(Handle, "get_mesh", array{})]]
