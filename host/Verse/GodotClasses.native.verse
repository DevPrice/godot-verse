    DebugPathCustomColorSetter<epic_internal>(Accessor:accessor, Value:color)<transacts>:void = VhCallVoid(Handle, "set_debug_path_custom_color", array{VhFromColor(Value)})
    DebugPathCustomColorGetter<epic_internal>(Accessor:accessor, Field:string)<transacts>:float =
        Current := VhToColor(VhCallValue(Handle, "get_debug_path_custom_color", array{}))
        if (Field = "R") then Current.R else if (Field = "G") then Current.G else if (Field = "B") then Current.B else Current.A
    DebugPathCustomColorSetter<epic_internal>(Accessor:accessor, Field:string, Value:float)<transacts>:void =
        Current := VhToColor(VhCallValue(Handle, "get_debug_path_custom_color", array{}))
        if (Field = "R"):
            VhCallVoid(Handle, "set_debug_path_custom_color", array{VhFromColor(color{R := Value, G := Current.G, B := Current.B, A := Current.A})})
        else if (Field = "G"):
            VhCallVoid(Handle, "set_debug_path_custom_color", array{VhFromColor(color{R := Current.R, G := Value, B := Current.B, A := Current.A})})
        else if (Field = "B"):
            VhCallVoid(Handle, "set_debug_path_custom_color", array{VhFromColor(color{R := Current.R, G := Current.G, B := Value, A := Current.A})})
        else:
            VhCallVoid(Handle, "set_debug_path_custom_color", array{VhFromColor(color{R := Current.R, G := Current.G, B := Current.B, A := Value})})
