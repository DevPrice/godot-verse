VariantFromPackedVector3Array<public>(Value:[]vector3)<reads>:variant = VhFromVector3s(Value)

VariantFromPackedColorArray<public>(Value:[]color)<reads>:variant = VhFromColors(Value)

VariantFromPackedVector4Array<public>(Value:[]vector4)<reads>:variant = VhFromVector4s(Value)

# --- the packed arrays of a math type ----------------------------------------
#
# These ride as a reference like every other container, but their elements are structs rather than
# scalars, so each crosses as its own variant instead of flattening into a lane sequence.

VhToVector2s(Value:variant)<reads>:[]vector2 = for (V : VhRefValues(Value.Ref)) { VhToVector2(V) }
VhFromVector2s(Values:[]vector2)<reads>:variant = VhFromValues(TagPackedVector2Array, for (V : Values) { VhFromVector2(V) })
VhToVector3s(Value:variant)<reads>:[]vector3 = for (V : VhRefValues(Value.Ref)) { VhToVector3(V) }
VhFromVector3s(Values:[]vector3)<reads>:variant = VhFromValues(TagPackedVector3Array, for (V : Values) { VhFromVector3(V) })
VhToColors(Value:variant)<reads>:[]color = for (V : VhRefValues(Value.Ref)) { VhToColor(V) }
VhFromColors(Values:[]color)<reads>:variant = VhFromValues(TagPackedColorArray, for (V : Values) { VhFromColor(V) })
VhToVector4s(Value:variant)<reads>:[]vector4 = for (V : VhRefValues(Value.Ref)) { VhToVector4(V) }
VhFromVector4s(Values:[]vector4)<reads>:variant = VhFromValues(TagPackedVector4Array, for (V : Values) { VhFromVector4(V) })

# --- Godot's containers ------------------------------------------------------
#
# A typed accessor pair per element type, because a script cannot spell a `variant` -- the packers
# are module-scoped so that a user cannot hold a raw reference that outlives what it names
# (R-TYPE-7). Every read is failable: a key that is absent, an index out of range, and an element
# of another type are all the same answer, and it is "no" rather than an error.

godot_array<public> := class<computes>(godot_ref):

    # How many elements it holds.
    Length<public>()<reads>:int = VhRefSize(Ref)

    # The whole thing as a Verse array of its elements' own type, which is a copy:
    # Verse's arrays are values, so mutating what this returns reaches nothing.
    ToVariants<public>()<reads>:[]variant = for (V : VhRefValues(Ref)) { VhToVariant(V) }
    ToLogics<public>()<reads>:[]logic = for (V : VhRefValues(Ref)) { VhToLogic(V) }
    ToInts<public>()<reads>:[]int = for (V : VhRefValues(Ref)) { VhToInt(V) }
    ToFloats<public>()<reads>:[]float = for (V : VhRefValues(Ref)) { VhToFloat(V) }
    ToStrings<public>()<reads>:[]string = for (V : VhRefValues(Ref)) { VhToString(V) }
    ToVector2s<public>()<reads>:[]vector2 = for (V : VhRefValues(Ref)) { VhToVector2(V) }
    ToVector2is<public>()<reads>:[]vector2i = for (V : VhRefValues(Ref)) { VhToVector2i(V) }
    ToVector3s<public>()<reads>:[]vector3 = for (V : VhRefValues(Ref)) { VhToVector3(V) }
    ToColors<public>()<reads>:[]color = for (V : VhRefValues(Ref)) { VhToColor(V) }
    ToObjects<public>()<reads>:[]object = for (V : VhRefValues(Ref), E := VhToObject[V]) { E }

    GetVariant<public>(Index:int)<decides><reads>:variant = VhToVariant(VhRefGet[Ref, VhFromInt(Index)])
    SetVariant<public>(Index:int, Value:variant)<transacts>:void = VhRefSet(Ref, VhFromInt(Index), VhFromVariant(Value))
    AddVariant<public>(Value:variant)<transacts>:void = VhRefSet(Ref, VhFromInt(VhRefSize(Ref)), VhFromVariant(Value))
    GetLogic<public>(Index:int)<decides><reads>:logic = VhToLogic(VhRefGet[Ref, VhFromInt(Index)])
    SetLogic<public>(Index:int, Value:logic)<transacts>:void = VhRefSet(Ref, VhFromInt(Index), VhFromLogic(Value))
    AddLogic<public>(Value:logic)<transacts>:void = VhRefSet(Ref, VhFromInt(VhRefSize(Ref)), VhFromLogic(Value))
    GetInt<public>(Index:int)<decides><reads>:int = VhToInt(VhRefGet[Ref, VhFromInt(Index)])
    SetInt<public>(Index:int, Value:int)<transacts>:void = VhRefSet(Ref, VhFromInt(Index), VhFromInt(Value))
    AddInt<public>(Value:int)<transacts>:void = VhRefSet(Ref, VhFromInt(VhRefSize(Ref)), VhFromInt(Value))
    GetFloat<public>(Index:int)<decides><reads>:float = VhToFloat(VhRefGet[Ref, VhFromInt(Index)])
    SetFloat<public>(Index:int, Value:float)<transacts>:void = VhRefSet(Ref, VhFromInt(Index), VhFromFloat(Value))
    AddFloat<public>(Value:float)<transacts>:void = VhRefSet(Ref, VhFromInt(VhRefSize(Ref)), VhFromFloat(Value))
    GetString<public>(Index:int)<decides><reads>:string = VhToString(VhRefGet[Ref, VhFromInt(Index)])
    SetString<public>(Index:int, Value:string)<transacts>:void = VhRefSet(Ref, VhFromInt(Index), VhFromString(Value))
    AddString<public>(Value:string)<transacts>:void = VhRefSet(Ref, VhFromInt(VhRefSize(Ref)), VhFromString(Value))
    GetVector2<public>(Index:int)<decides><reads>:vector2 = VhToVector2(VhRefGet[Ref, VhFromInt(Index)])
    SetVector2<public>(Index:int, Value:vector2)<transacts>:void = VhRefSet(Ref, VhFromInt(Index), VhFromVector2(Value))
    AddVector2<public>(Value:vector2)<transacts>:void = VhRefSet(Ref, VhFromInt(VhRefSize(Ref)), VhFromVector2(Value))
    GetVector2i<public>(Index:int)<decides><reads>:vector2i = VhToVector2i(VhRefGet[Ref, VhFromInt(Index)])
    SetVector2i<public>(Index:int, Value:vector2i)<transacts>:void = VhRefSet(Ref, VhFromInt(Index), VhFromVector2i(Value))
    AddVector2i<public>(Value:vector2i)<transacts>:void = VhRefSet(Ref, VhFromInt(VhRefSize(Ref)), VhFromVector2i(Value))
    GetVector3<public>(Index:int)<decides><reads>:vector3 = VhToVector3(VhRefGet[Ref, VhFromInt(Index)])
    SetVector3<public>(Index:int, Value:vector3)<transacts>:void = VhRefSet(Ref, VhFromInt(Index), VhFromVector3(Value))
    AddVector3<public>(Value:vector3)<transacts>:void = VhRefSet(Ref, VhFromInt(VhRefSize(Ref)), VhFromVector3(Value))
    GetColor<public>(Index:int)<decides><reads>:color = VhToColor(VhRefGet[Ref, VhFromInt(Index)])
    SetColor<public>(Index:int, Value:color)<transacts>:void = VhRefSet(Ref, VhFromInt(Index), VhFromColor(Value))
    AddColor<public>(Value:color)<transacts>:void = VhRefSet(Ref, VhFromInt(VhRefSize(Ref)), VhFromColor(Value))
