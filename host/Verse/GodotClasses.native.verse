            VhCallVoid(Handle, "set_fixed_icon_size", array{VhFromVector2i(vector2i{X := Value, Y := Current.Y})})
        else:
            VhCallVoid(Handle, "set_fixed_icon_size", array{VhFromVector2i(vector2i{X := Current.X, Y := Value})})
