# --- Godot's Variant ---------------------------------------------------------
#
# A Godot value whose type is not known until it arrives. The type is nameable so it can appear in a
# signature; its lanes are not, so a script reads one through the failable `As<GodotType>` readers
# below and builds one through the matching `VariantFrom<GodotType>` (R-TYPE-7, amended in Phase 2).
# Neither family is overloaded -- the type is in the name, for the reason gen_verse_api.py records
# where it emits them.
#
#     if (Health := AsInt[V]):
#         Print("hp {Health}")
#
#     case (VariantKind(V)):          # when the type is not known at all
#         variant_type.TypeInt => Print("an int")
#         _ => Print("something else")
#
#     Node.SetMeta("score", VariantFromInt(42))
#
# Reading is a <decides> free function rather than a cast, because Verse's own cast rejects a struct
# on both sides -- see docs/phase-2-design.md 1 and 4.1. It reads the same at the call site and it
# boxes nothing.

VariantKind<public>(Value:variant)<reads>:variant_type =
    case (Value.Tag):
        1 => variant_type.TypeBool
        2 => variant_type.TypeInt
        3 => variant_type.TypeFloat
        4 => variant_type.TypeString
        5 => variant_type.TypeVector2
        6 => variant_type.TypeVector2i
        9 => variant_type.TypeVector3
        10 => variant_type.TypeVector3i
        12 => variant_type.TypeVector4
        13 => variant_type.TypeVector4i
        7 => variant_type.TypeRect2
        8 => variant_type.TypeRect2i
        14 => variant_type.TypePlane
        15 => variant_type.TypeQuaternion
        16 => variant_type.TypeAabb
        17 => variant_type.TypeBasis
        11 => variant_type.TypeTransform2d
        18 => variant_type.TypeTransform3d
        19 => variant_type.TypeProjection
        20 => variant_type.TypeColor
        21 => variant_type.TypeStringName
        22 => variant_type.TypeNodePath
        23 => variant_type.TypeRid
        24 => variant_type.TypeObject
        25 => variant_type.TypeCallable
        26 => variant_type.TypeSignal
        27 => variant_type.TypeDictionary
        28 => variant_type.TypeArray
        29 => variant_type.TypePackedByteArray
        30 => variant_type.TypePackedInt32Array
        31 => variant_type.TypePackedInt64Array
        32 => variant_type.TypePackedFloat32Array
        33 => variant_type.TypePackedFloat64Array
        34 => variant_type.TypePackedStringArray
        35 => variant_type.TypePackedVector2Array
        36 => variant_type.TypePackedVector3Array
        37 => variant_type.TypePackedColorArray
        38 => variant_type.TypePackedVector4Array
        _ => variant_type.TypeNil

VhToObject(Value:variant)<decides><reads>:object = object[VhObjectFrom[Value]]

VhToVariant(Value:variant)<reads>:variant = Value

VhFromVariant(Value:variant)<reads>:variant = Value

AsBool<public>(Value:variant)<decides><reads>:logic =
    Value.Tag = TagBool
    VhToLogic(Value)

AsInt<public>(Value:variant)<decides><reads>:int =
    Value.Tag = TagInt
    VhToInt(Value)

