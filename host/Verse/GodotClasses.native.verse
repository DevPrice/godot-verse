audio_server<public> := class(object):

    var BusCount<public><getter(BusCountGetter)><setter(BusCountSetter)>:int = external {}
    BusCountGetter<epic_internal>(Accessor:accessor)<transacts>:int = VhToInt(VhCallValue(Handle, "get_bus_count", array{}))
    BusCountSetter<epic_internal>(Accessor:accessor, Value:int)<transacts>:void = VhCallVoid(Handle, "set_bus_count", array{VhFromInt(Value)})
    var PlaybackSpeedScale<public><getter(PlaybackSpeedScaleGetter)><setter(PlaybackSpeedScaleSetter)>:float = external {}
