    LightmapSizeHintGetter<epic_internal>(Accessor:accessor, Field:string)<transacts>:int =
        Current := VhToVector2i(VhCallValue(Handle, "get_lightmap_size_hint", array{}))
        if (Field = "X") then Current.X else Current.Y
    LightmapSizeHintSetter<epic_internal>(Accessor:accessor, Field:string, Value:int)<transacts>:void =
        Current := VhToVector2i(VhCallValue(Handle, "get_lightmap_size_hint", array{}))
        if (Field = "X"):
            VhCallVoid(Handle, "set_lightmap_size_hint", array{VhFromVector2i(vector2i{X := Value, Y := Current.Y})})
