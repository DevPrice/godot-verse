xr_server<public> := class(object):

    var CameraLockedToOrigin<public><getter(CameraLockedToOriginGetter)><setter(CameraLockedToOriginSetter)>:logic = external {}
    CameraLockedToOriginGetter<epic_internal>(Accessor:accessor)<transacts>:logic = VhToLogic(VhCallValue(Handle, "is_camera_locked_to_origin", array{}))
    CameraLockedToOriginSetter<epic_internal>(Accessor:accessor, Value:logic)<transacts>:void = VhCallVoid(Handle, "set_camera_locked_to_origin", array{VhFromLogic(Value)})
    var WorldOrigin<public><getter(WorldOriginGetter)><setter(WorldOriginSetter)>:vector3 = external {}
    WorldOriginGetter<epic_internal>(Accessor:accessor)<transacts>:vector3 = VhToVector3(VhCallValue(Handle, "get_world_origin", array{}))
    WorldOriginSetter<epic_internal>(Accessor:accessor, Value:vector3)<transacts>:void = VhCallVoid(Handle, "set_world_origin", array{VhFromVector3(Value)})
    WorldOriginGetter<epic_internal>(Accessor:accessor, Field:string)<transacts>:float =
        Current := VhToVector3(VhCallValue(Handle, "get_world_origin", array{}))
        if (Field = "X") then Current.X else if (Field = "Y") then Current.Y else Current.Z
    WorldOriginSetter<epic_internal>(Accessor:accessor, Field:string, Value:float)<transacts>:void =
        Current := VhToVector3(VhCallValue(Handle, "get_world_origin", array{}))
        if (Field = "X"):
            VhCallVoid(Handle, "set_world_origin", array{VhFromVector3(vector3{X := Value, Y := Current.Y, Z := Current.Z})})
        else if (Field = "Y"):
            VhCallVoid(Handle, "set_world_origin", array{VhFromVector3(vector3{X := Current.X, Y := Value, Z := Current.Z})})
        else:
            VhCallVoid(Handle, "set_world_origin", array{VhFromVector3(vector3{X := Current.X, Y := Current.Y, Z := Value})})
    var WorldScale<public><getter(WorldScaleGetter)><setter(WorldScaleSetter)>:float = external {}
    WorldScaleGetter<epic_internal>(Accessor:accessor)<transacts>:float = VhToFloat(VhCallValue(Handle, "get_world_scale", array{}))
