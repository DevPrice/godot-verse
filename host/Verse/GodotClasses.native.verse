    TileSizeGetter<epic_internal>(Accessor:accessor, Field:string)<transacts>:int =
        Current := VhToVector2i(VhCallValue(Handle, "get_tile_size", array{}))
        if (Field = "X") then Current.X else Current.Y
    TileSizeSetter<epic_internal>(Accessor:accessor, Field:string, Value:int)<transacts>:void =
        Current := VhToVector2i(VhCallValue(Handle, "get_tile_size", array{}))
        if (Field = "X"):
            VhCallVoid(Handle, "set_tile_size", array{VhFromVector2i(vector2i{X := Value, Y := Current.Y})})
        else:
            VhCallVoid(Handle, "set_tile_size", array{VhFromVector2i(vector2i{X := Current.X, Y := Value})})
