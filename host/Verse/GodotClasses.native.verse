    var BlendConstant<public><getter(BlendConstantGetter)><setter(BlendConstantSetter)>:color = external {}
    BlendConstantGetter<epic_internal>(Accessor:accessor)<transacts>:color = VhToColor(VhCallValue(Handle, "get_blend_constant", array{}))
    BlendConstantSetter<epic_internal>(Accessor:accessor, Value:color)<transacts>:void = VhCallVoid(Handle, "set_blend_constant", array{VhFromColor(Value)})
    BlendConstantGetter<epic_internal>(Accessor:accessor, Field:string)<transacts>:float =
        Current := VhToColor(VhCallValue(Handle, "get_blend_constant", array{}))
        if (Field = "R") then Current.R else if (Field = "G") then Current.G else if (Field = "B") then Current.B else Current.A
    BlendConstantSetter<epic_internal>(Accessor:accessor, Field:string, Value:float)<transacts>:void =
        Current := VhToColor(VhCallValue(Handle, "get_blend_constant", array{}))
        if (Field = "R"):
            VhCallVoid(Handle, "set_blend_constant", array{VhFromColor(color{R := Value, G := Current.G, B := Current.B, A := Current.A})})
        else if (Field = "G"):
            VhCallVoid(Handle, "set_blend_constant", array{VhFromColor(color{R := Current.R, G := Value, B := Current.B, A := Current.A})})
        else if (Field = "B"):
            VhCallVoid(Handle, "set_blend_constant", array{VhFromColor(color{R := Current.R, G := Current.G, B := Value, A := Current.A})})
        else:
            VhCallVoid(Handle, "set_blend_constant", array{VhFromColor(color{R := Current.R, G := Current.G, B := Current.B, A := Value})})
