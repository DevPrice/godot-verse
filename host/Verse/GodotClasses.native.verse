visual_shader<public> := class(shader):

    var GraphOffset<public><getter(GraphOffsetGetter)><setter(GraphOffsetSetter)>:vector2 = external {}
    GraphOffsetGetter<epic_internal>(Accessor:accessor)<transacts>:vector2 = VhToVector2(VhCallValue(Handle, "get_graph_offset", array{}))
    GraphOffsetSetter<epic_internal>(Accessor:accessor, Value:vector2)<transacts>:void = VhCallVoid(Handle, "set_graph_offset", array{VhFromVector2(Value)})
    GraphOffsetGetter<epic_internal>(Accessor:accessor, Field:string)<transacts>:float =
        Current := VhToVector2(VhCallValue(Handle, "get_graph_offset", array{}))
        if (Field = "X") then Current.X else Current.Y
    GraphOffsetSetter<epic_internal>(Accessor:accessor, Field:string, Value:float)<transacts>:void =
        Current := VhToVector2(VhCallValue(Handle, "get_graph_offset", array{}))
        if (Field = "X"):
            VhCallVoid(Handle, "set_graph_offset", array{VhFromVector2(vector2{X := Value, Y := Current.Y})})
        else:
            VhCallVoid(Handle, "set_graph_offset", array{VhFromVector2(vector2{X := Current.X, Y := Value})})
    AddNode<public>(Type:visual_shader_type, Node:visual_shader_node, Position:vector2, Id:int)<transacts>:void = VhCallVoid(Handle, "add_node", array{VhFromVisualShaderType(Type), VhFromObject(Node), VhFromVector2(Position), VhFromInt(Id)})
