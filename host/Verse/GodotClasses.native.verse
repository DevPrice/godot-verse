    OriginOffsetGetter<epic_internal>(Accessor:accessor, Field:string)<transacts>:float =
        Current := VhToVector3(VhCallValue(Handle, "get_origin_offset", array{}))
        if (Field = "X") then Current.X else if (Field = "Y") then Current.Y else Current.Z
    OriginOffsetSetter<epic_internal>(Accessor:accessor, Field:string, Value:float)<transacts>:void =
        Current := VhToVector3(VhCallValue(Handle, "get_origin_offset", array{}))
        if (Field = "X"):
            VhCallVoid(Handle, "set_origin_offset", array{VhFromVector3(vector3{X := Value, Y := Current.Y, Z := Current.Z})})
        else if (Field = "Y"):
            VhCallVoid(Handle, "set_origin_offset", array{VhFromVector3(vector3{X := Current.X, Y := Value, Z := Current.Z})})
        else:
            VhCallVoid(Handle, "set_origin_offset", array{VhFromVector3(vector3{X := Current.X, Y := Current.Y, Z := Value})})
