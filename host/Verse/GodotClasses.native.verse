    DragMarginGetter<epic_internal>(Accessor:accessor)<transacts>:int = VhToInt(VhCallValue(Handle, "get_drag_margin", array{}))
    DragMarginSetter<epic_internal>(Accessor:accessor, Value:int)<transacts>:void = VhCallVoid(Handle, "set_drag_margin", array{VhFromInt(Value)})
    var TintColor<public><getter(TintColorGetter)><setter(TintColorSetter)>:color = external {}
    TintColorGetter<epic_internal>(Accessor:accessor)<transacts>:color = VhToColor(VhCallValue(Handle, "get_tint_color", array{}))
    TintColorSetter<epic_internal>(Accessor:accessor, Value:color)<transacts>:void = VhCallVoid(Handle, "set_tint_color", array{VhFromColor(Value)})
    TintColorGetter<epic_internal>(Accessor:accessor, Field:string)<transacts>:float =
        Current := VhToColor(VhCallValue(Handle, "get_tint_color", array{}))
        if (Field = "R") then Current.R else if (Field = "G") then Current.G else if (Field = "B") then Current.B else Current.A
    TintColorSetter<epic_internal>(Accessor:accessor, Field:string, Value:float)<transacts>:void =
        Current := VhToColor(VhCallValue(Handle, "get_tint_color", array{}))
        if (Field = "R"):
            VhCallVoid(Handle, "set_tint_color", array{VhFromColor(color{R := Value, G := Current.G, B := Current.B, A := Current.A})})
        else if (Field = "G"):
            VhCallVoid(Handle, "set_tint_color", array{VhFromColor(color{R := Current.R, G := Value, B := Current.B, A := Current.A})})
        else if (Field = "B"):
            VhCallVoid(Handle, "set_tint_color", array{VhFromColor(color{R := Current.R, G := Current.G, B := Value, A := Current.A})})
        else:
            VhCallVoid(Handle, "set_tint_color", array{VhFromColor(color{R := Current.R, G := Current.G, B := Current.B, A := Value})})
    var TintColorEnabled<public><getter(TintColorEnabledGetter)><setter(TintColorEnabledSetter)>:logic = external {}
