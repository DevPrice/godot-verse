# Godot's XRBodyTracker.JointFlags.
xr_body_tracker_joint_flags<public> := enum:
    OrientationValid
    OrientationTracked
    PositionValid
    PositionTracked

VhToXrBodyTrackerJointFlags(Value:variant)<reads>:xr_body_tracker_joint_flags =
    case (VhToInt(Value)):
        1 => xr_body_tracker_joint_flags.OrientationValid
        2 => xr_body_tracker_joint_flags.OrientationTracked
        4 => xr_body_tracker_joint_flags.PositionValid
        8 => xr_body_tracker_joint_flags.PositionTracked
        _ =>
            VhTypeMismatch("xr_body_tracker_joint_flags", Value)
            xr_body_tracker_joint_flags.OrientationValid

