csg_box3d<public> := class(csg_primitive3d):

    var Size<public><getter(SizeGetter)><setter(SizeSetter)>:vector3 = external {}
    SizeGetter<epic_internal>(Accessor:accessor)<transacts>:vector3 = VhToVector3(VhCallValue(Handle, "get_size", array{}))
    SizeSetter<epic_internal>(Accessor:accessor, Value:vector3)<transacts>:void = VhCallVoid(Handle, "set_size", array{VhFromVector3(Value)})
    SizeGetter<epic_internal>(Accessor:accessor, Field:string)<transacts>:float =
        Current := VhToVector3(VhCallValue(Handle, "get_size", array{}))
        if (Field = "X") then Current.X else if (Field = "Y") then Current.Y else Current.Z
    SizeSetter<epic_internal>(Accessor:accessor, Field:string, Value:float)<transacts>:void =
        Current := VhToVector3(VhCallValue(Handle, "get_size", array{}))
        if (Field = "X"):
            VhCallVoid(Handle, "set_size", array{VhFromVector3(vector3{X := Value, Y := Current.Y, Z := Current.Z})})
        else if (Field = "Y"):
            VhCallVoid(Handle, "set_size", array{VhFromVector3(vector3{X := Current.X, Y := Value, Z := Current.Z})})
        else:
            VhCallVoid(Handle, "set_size", array{VhFromVector3(vector3{X := Current.X, Y := Current.Y, Z := Value})})
