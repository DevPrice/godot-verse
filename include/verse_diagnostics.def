VERSE_DIAG(VG4114, "push_warning, once: a .verse loaded with no VerseRuntime singleton",
	"VerseRuntime singleton is not available")

// VG42xx: the per-frame pump and how a runtime error is reported.
VERSE_DIAG(VG4201, "push_warning: vh_tick asked for with no host",
	"tick called with no host loaded")
VERSE_DIAG(VG4202, "push_warning, rate limited: the frame budget ran out (R-ASYNC-6)",
	"the frame budget ({budget} ms, verse/runtime/frame_budget_ms) ran out with {jobs} queued job(s) "
	"left. They run next frame. The budget governs queued work only -- a task awaiting a Godot signal "
	"resumes inside the emission and is not budgeted.")
VERSE_DIAG(VG4203, "printed under a runtime error's stack: repeats suppressed (R-DIAG-3)",
	"{count} more stack trace(s) from this error were dropped.")
VERSE_DIAG(VG4204, "printed under every runtime error's stack",
	"The call that raised this was rolled back, so what it changed before the error is undone, except "
	"by the Godot methods listed in docs/nonatomic-methods.md. An error in a function Godot calls every "
	"frame can repeat for that reason.")

// VG5xxx: building and analysing the project. VG50xx is about names, modules and the build itself.
VERSE_DIAG(VG5001, "push_error, per build: a .vmodule marker whose name is not an identifier",
	"\"{name}\" is not a Verse module name, so this directory is not a module and its scripts stay in "
	"the one above it. A module name is a letter or underscore followed by letters, digits or "
	"underscores -- gameplay.vmodule, not my-stuff.vmodule.")
VERSE_DIAG(VG5002, "push_error, per build: two files declare one name in one module",
	"{path} and {other} both declare `{name}` in {module}. A name may only be declared once per "
	"module. Put one of them in a module of its own -- right-click its directory in the FileSystem dock "
	"and choose \"Make Verse Module\" -- or rename one of the files.")
VERSE_DIAG(VG5003, "push_error, per build: two @global_class classes register one Godot name",
	"{path} and {other} both register the Godot class name `{name}`. ClassDB is one flat namespace and "
	"a module is deliberately not part of it, so two @global_class classes may not share a name however "
	"far apart they are. Rename one of the files.")
VERSE_DIAG(VG5004, "_validate warning and build log: @global_class on a class not named after its file (B19 Stage B)",
	"`@global_class` on `{name}` registers nothing. Godot collects one global class per script file, "
	"and only `{stem}` -- the class named after this file -- can be that class. Move `{name}` into a "
	"file of its own to register it, or drop the attribute: a member typed as `{name}` still exports, "
	"filtered by its nearest Godot base class.")
VERSE_DIAG(VG5005, "_validate error and build log: a class extending a script's generated binding (R-INT-10)",
	"`{name}` extends `{base}`, which is the generated binding for a class a *script* declares. That "
	"cannot work: Godot gives an object exactly one script instance, so the inherited methods would "
	"forward to a `{base}` that is not there -- `{name}`'s own script is the only one the node has "
	"(R-INT-6, R-INT-10). Extend the binding's own Godot base instead and hold the other node, or move "
	"the shared code into Verse.")
VERSE_DIAG(VG5006, "push_warning, per build: a script base more than one file answers to",
	"{path} derives from `{base}`, and more than one script answers to that name ({candidates}). The "
	"build resolves it through modules; the class picker cannot, so until this build finishes it "
	"offers Node as this script's base type.")
VERSE_DIAG(VG5007, "push_warning: a build's errors withheld over an incomplete binding roster (B36)",
	"this build ran against an incomplete binding roster, so its errors are withheld for one pass. "
	"{classes} is declared with no members, because the script it stands for names a Verse class -- "
	"loading it to describe it while a .verse is loading would be a cyclic load, so it is held back "
	"instead. A Verse file that names one of its *methods* does not compile on this pass, and a node "
	"that loses its script over it is reported by GDScript as a null value with nothing said about "
	"Verse. The next build describes it in full; what no build can repair is a node the scene has "
	"already finished instantiating. Reach the method through `Call`/`Callv` (R-INT-2) rather than "
	"naming it, and the cycle is broken.")
VERSE_DIAG(VG5008, "_validate warning on line 1: another file does not compile",
	"This file compiles, but {files} {verb}, so the project will not build and Play will be refused. "
	"Open {pronoun} to see why, or Project > Tools > Build Verse to log every error at once.")
VERSE_DIAG(VG5009, "push_warning: a build failed and published nothing (R-ITER-5)",
	"the project did not build, so no new code was published. The editor's analysis -- diagnostics, "
	"completion and the shape of the exported properties -- is live either way; fix the errors and "
	"build again to replace what is running.")

// VG51xx: appended to the compiler's unknown-identifier error when the name is a Godot member the
// mirror deliberately does not carry (R-SCN-2). One per reason in src/verse_api_skipped.h.
VERSE_DIAG(VG5101, "appended to glitch 3506 (superseded_by_property)",
	"Godot has {member}, but it is reachable as the property {detail}.")
VERSE_DIAG(VG5102, "appended to glitch 3506 (property_renamed)",
	"Godot has {member}, but a Verse function already answers to that name, so it is the property "
	"{detail}.")
VERSE_DIAG(VG5103, "appended to glitch 3506 (method_renamed)",
	"Godot has {member}, but it is reachable as {detail}.")
VERSE_DIAG(VG5104, "appended to glitch 3506 (superseded_by_free_function)",
	"Godot has {member}, but it is reachable as {detail}, which is also what string interpolation uses.")
VERSE_DIAG(VG5105, "appended to glitch 3506 (property_*)",
	"Godot has {member}, but it cannot be a property, so Godot's own {detail} carry it instead.")
VERSE_DIAG(VG5106, "appended to glitch 3506 (virtual_no_default)",
	"Godot has {member}, but it is a Godot virtual returning {detail}, and an unoverridden virtual has "
	"to answer a value there is no way to write (R-NODE-7).")
VERSE_DIAG(VG5107, "appended to glitch 3506 (static)",
	"Godot has {member}, but it is static, and a static call has no Verse spelling yet (R-NODE-4).")
VERSE_DIAG(VG5108, "appended to glitch 3506 (vararg)",
	"Godot has {member}, but it takes a variable number of arguments, which the bridge cannot carry.")
VERSE_DIAG(VG5109, "appended to glitch 3506 (unmarshallable_pointer)",
	"Godot has {member}, but it takes a raw C pointer, which no scripting language can pass.")
VERSE_DIAG(VG5110, "appended to glitch 3506 (unsupported_type)",
	"Godot has {member}, but nothing can carry its {detail} across the boundary.")
VERSE_DIAG(VG5111, "appended to glitch 3506 (shadow)",
	"Godot has {member}, but a name it shares with an inherited member won.")
VERSE_DIAG(VG5112, "appended to glitch 3506 (math_not_written)",
	"Godot has {member}, but the math types are ordinary Verse rather than calls into Godot, and this "
	"one has not been written yet -- host/Verse/GodotMath.native.verse is where it goes.")
VERSE_DIAG(VG5113, "appended to glitch 3506 (utility_has_verse_spelling)",
	"Godot has {member}, but Verse spells it {detail}.")
VERSE_DIAG(VG5114, "appended to glitch 3506 (utility_variant_only)",
	"Godot has {member}, but its parameter or result is a Variant, which a script cannot spell -- the "
	"packers are module-scoped by R-TYPE-7, so there is no signature for it to have.")
VERSE_DIAG(VG5115, "appended to glitch 3506 (utility_not_dispatched)",
	"Godot has {member}, but it has no Verse counterpart and is not dispatched to Godot yet.")
VERSE_DIAG(VG5116, "appended to glitch 3506 (math_operator_not_written)",
	"Godot has {member}, but this operator has not been written for those operands yet -- the math "
	"types are ordinary Verse, and host/Verse/GodotMath.native.verse is where it goes.")
VERSE_DIAG(VG5117, "appended to glitch 3506 (a skip reason this build does not know)",
	"Godot has {member}, but it was skipped: {reason}.")

// VG52xx: appended to the compiler's unknown-identifier error when the name is declared in a module
// this file does not import (R-TOOL-12).
VERSE_DIAG(VG5201, "appended to glitch 3506: one module declares the name",
	"It is declared in a module this file does not import; add {using} at the top of the file.")
VERSE_DIAG(VG5202, "appended to glitch 3506: several modules declare the name",
	"It is declared in more than one module, so which was meant is yours to say; add {using} at the "
	"top of the file.")

