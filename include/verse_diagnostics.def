	"a letter or underscore followed by letters, digits or underscores -- and the directory can keep the "
	"name it has.")
VERSE_DIAG(VG6301, "push_error: Convert to Verse could not write a converted file",
	"could not write {path}.")

// VG7xxx: the interpreter, vm/. VG70xx is loading what the cooker wrote; VG71xx is running it.
VERSE_DIAG(VG7001, "vh_init refusal: the interpreter was given no cooked directory",
	"This runtime runs cooked Verse only, and vh_init was given no cooked directory.")
VERSE_DIAG(VG7002, "vh_init refusal: the sidecar or program.vbc is absent",
	"Verse data not found at {path}. The export is incomplete; export the project again.")
VERSE_DIAG(VG7003, "vh_init refusal: the cook's ABI stamp is not this build's",
	"This game's Verse data was cooked by a different build of godot-verse (cooked {cooked}, host "
	"{host}/verse_vm). Export the project again.")
VERSE_DIAG(VG7004, "vh_init refusal: program.vbc and the sidecar came from two cooks",
	"{program} and {sidecar} were written by different cooks. Export the project again.")
VERSE_DIAG(VG7005, "vh_init refusal: a sidecar of another version",
	"{path} was written by sidecar version {version}; this host reads version {wanted}. Re-export the "
	"project.")
VERSE_DIAG(VG7006, "vh_init refusal: the sidecar parsed and is not a sidecar",
	"{path} is not a valid class sidecar: {what}.")
VERSE_DIAG(VG7007, "vh_init refusal: the sidecar is not JSON",
	"{path} is not valid JSON")
VERSE_DIAG(VG7010, "vh_init refusal: program.vbc is not a program",
	"{path} is not a Verse program: it does not begin with VBC1.")
VERSE_DIAG(VG7011, "vh_init refusal: program.vbc of another format version",
	"{path} is format version {version}; this runtime reads version {wanted}. Export the project again.")
VERSE_DIAG(VG7012, "vh_init refusal: program.vbc written for another op set",
	"{path} was written for another Verse op set (schema {schema}); this runtime reads schema {wanted}. "
	"Export the project again with a matching build.")
VERSE_DIAG(VG7013, "vh_init refusal: program.vbc uses an op this runtime does not implement",
	"{path} uses the op {op} in {procedure}, which this runtime does not implement.")
VERSE_DIAG(VG7014, "vh_init refusal: program.vbc lacks a definition the runtime needs",
	"{path} names no {definition} definition, which this runtime needs. Export the project again.")
VERSE_DIAG(VG7015, "vh_init refusal: program.vbc is malformed",
	"{path} is malformed: {what}.")
VERSE_DIAG(VG7016, "vh_init refusal: program.vbc is cut short",
	"{path} is truncated or malformed: {what}.")
VERSE_DIAG(VG7101, "vm/ runtime error: a result the wire cannot carry",
	"The result of {function} could not be handed to the host: {why}.")
VERSE_DIAG(VG7102, "vm/ runtime error: a native this runtime does not implement",
	"The native function {native} is not implemented by this runtime.")
VERSE_DIAG(VG7103, "vm/ runtime error: the interpreter found its own state inconsistent",
	"VM invariant violated: {what} at {where}")
VERSE_DIAG(VG7104, "vm/ runtime error: a construct this runtime cannot run",
	"This runtime cannot run {what} yet: {where}")
VERSE_DIAG(VG7105, "vm/ runtime error: a stage-1 wait on an unknown value",
	"Stage-1 interpreter cannot wait: {where} needs a value that is not yet known")
