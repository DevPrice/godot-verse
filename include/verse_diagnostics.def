VERSE_DIAG(VG4107, "push_error: the editor was handed a host of another kind",
	"{dll} is {kind}; the Godot editor needs the editor host. Build it with `python "
	"tools/build_host.py`.")
VERSE_DIAG(VG4108, "push_error: an exported game was handed a host of another kind",
	"{dll} is {kind}; an exported game needs the runtime host. Build it with `python "
	"tools/build_host.py --target VerseHostRuntime`.")
VERSE_DIAG(VG4109, "exported game's refusal to start: a host of another kind",
	"Verse shipped the wrong host: {dll} is {kind}.")
VERSE_DIAG(VG4110, "push_error, at the next host load: the last run left a fatal-error record (B43)",
	"The previous run ended in a Verse host fatal error. What it recorded:\n{record}")
VERSE_DIAG(VG4111, "push_error: vh_init refused",
	"vh_init failed with status {status}")
VERSE_DIAG(VG4112, "exported game's refusal to start: vh_init refused and said nothing",
	"Verse could not start (vh_init returned {status}).")
VERSE_DIAG(VG4113, "push_error, when Play ends: the game left a fatal-error record (B43)",
