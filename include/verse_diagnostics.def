// The registry of every sentence this bridge writes itself: VERSE_DIAG(id, where, text).
//
// Included by include/verse_diagnostics.h, once per expansion, and parsed by
// tests/verse_diagnostics/test_verse_diagnostics.py, which is why each row is exactly one
// VERSE_DIAG( ... ) whose text is adjacent string literals and nothing else. docs/diagnostics.md
// holds the numbering scheme and one "what to do" per row, and the test holds the two to each other.
//
// An ID is never reused or renumbered: a test, a search engine or an author's note may hold one. A
// sentence whose meaning changes gets a new row; one whose wording is only improved keeps its ID.
// `{name}` in a text is a placeholder, filled by name; any other brace is literal.

// VG1xxx: `@export` members the inspector cannot carry (R-EXP-1, R-EXP-2, R-EXP-3).
VERSE_DIAG(VG1001, "_validate warning and build log (VH_EXPORT_OBJECT_NOT_OPTIONAL)",
	"{name} is a {class}, and the inspector may leave that slot empty. Declare it `?{class}` so the "
	"member can hold the empty case.")
VERSE_DIAG(VG1002, "_validate warning and build log (VH_EXPORT_OPTION_NOT_OBJECT)",
	"{name} is an option around a value the inspector has no empty slot for. Only a node or a resource "
	"can be left unassigned.")
VERSE_DIAG(VG1003, "_validate warning and build log (VH_EXPORT_HINT_WRONG_TYPE)",
	"{name} carries {attribute}, which describes {wants} -- and this member is not one. The attribute "
	"exists because the declared type cannot say what a value is for, so the two have to be written to "
	"agree.")
VERSE_DIAG(VG1004, "_validate warning and build log (VH_EXPORT_SCRIPT_CLASS_NOT_GLOBAL)",
	"{name} refers to {class}, which is neither a node nor a resource, so the inspector has nothing to "
	"draw for it. Derive {class} from a Godot class the inspector can pick one of.")
VERSE_DIAG(VG1005, "_validate warning and build log (VH_EXPORT_BINDING_CLASS_UNSUPPORTED, with a native base)",
	"{name} refers to {class}, which is a GDScript class, and `@export` cannot carry a GDScript class "
	"reached through a generated binding yet. Export its native base class `{native}` instead.")
VERSE_DIAG(VG1006, "_validate warning and build log (VH_EXPORT_BINDING_CLASS_UNSUPPORTED, no native base)",
	"{name} refers to {class}, which is a GDScript class, and `@export` cannot carry a GDScript class "
	"reached through a generated binding yet.")
VERSE_DIAG(VG1007, "_validate warning and build log (VH_EXPORT_UNSUPPORTED_TYPE)",
	"{name} has a type godot-verse cannot carry to the inspector yet, so it is not exported.")
VERSE_DIAG(VG1008, "_validate warning and build log (B19 Stage C: an export the inspector draws and cannot save)",
	"{name} can be assigned in the inspector but not saved. Its class is not the one named after its "
	"file, so it has no script -- and a value survives a save only through one. Saving writes an empty "
	"sub-resource and the member reloads empty. Move the class into a file of its own.")

// VG2xxx: signals. VG20xx is a declaration Godot is never told about (R-SIG-1).
VERSE_DIAG(VG2001, "_validate warning and build log (VH_SIGNAL_IS_VAR); vm/ runtime raise",
	"{name} is a `var`, and a signal is an identity rather than a value. Its binding is made once "
	"against the object the member was built on, so reassigning it leaves the name pointing at "
	"nothing. Drop the `var`.")
VERSE_DIAG(VG2002, "_validate warning (VH_SIGNAL_NOT_PUBLIC, retired: no host built against this header sends it)",
	"{name} is not `<public>`, so nothing outside the class can connect to it -- which is the only "
	"thing connecting ever is. Declare it `{name}<public>`.")
VERSE_DIAG(VG2003, "_validate warning and build log (VH_SIGNAL_NO_GODOT_OWNER); vm/ runtime raise",
	"{name} is on a class that does not derive from `object`, so Godot never gives it an object to "
	"register the signal on. Unlike GDScript, where every class is an Object with a signal table of "
	"its own, a plain Verse class has no Godot counterpart at all.")
VERSE_DIAG(VG2004, "_validate warning and build log (VH_SIGNAL_PAYLOAD_NESTED_STRUCT); vm/ runtime raise",
	"{name} has a payload whose field `{field}` is itself a struct. A struct payload becomes one Godot "
	"argument per top-level field, and Godot has no argument shape for a struct, so there is no second "
	"level to flatten into. Flatten the field, or carry it as one of the mirrored math types.")
VERSE_DIAG(VG2005, "_validate warning and build log (VH_SIGNAL_PAYLOAD_UNSUPPORTED); vm/ runtime raise",
	"{name} has a payload argument `{field}` with no Godot type, so an emission would have nothing to "
	"carry it in.")
VERSE_DIAG(VG2006, "_validate warning and build log (VH_SIGNAL_NEEDS_ATTRIBUTE); vm/ runtime raise",
	"{name} carries no `@export_signal`, so Godot is never told about it: it cannot be connected in the "
	"Node panel, emitted to, or seen from GDScript. The attribute is what registers a member, the way "
	"`@export` is what sends one to the inspector. Write `@export_signal` on the line above `{name}`.")
VERSE_DIAG(VG2007, "_validate warning; vm/ runtime raise (a reject code this build does not know)",
	"{name} cannot be registered with Godot, so nothing can connect to it.")

// VG21xx: a signal used at run time in a way that cannot reach Godot. vm/ raises these; the UE host
// raises its own unprefixed copies (host/Private), which this registry does not reach.
VERSE_DIAG(VG2101, "vm/ runtime raise: Emit on a signal refused at analysis ({reason} is its VG20xx sentence)",
	"The signal `{signal}` was never registered with Godot: {reason} Nothing was emitted.")
VERSE_DIAG(VG2102, "vm/ runtime raise: Subscribe on a signal refused at analysis",
	"Cannot subscribe to `{signal}`: {reason}")
VERSE_DIAG(VG2103, "vm/ runtime raise: Await on a signal refused at analysis",
	"Cannot await `{signal}`: {reason}")
VERSE_DIAG(VG2104, "vm/ runtime raise: Emit with a payload the recorded shape cannot carry",
	"The payload of signal `{signal}` has no representation on the Godot wire, so nothing was emitted.")
VERSE_DIAG(VG2105, "vm/ runtime raise: Emit on a `signal` no member binding names",
	"A signal was emitted through an unbound `signal`. One a script built for itself rather than "
	"declared as a member of a class Godot instantiated names nothing, the way `godot_array{}` does.")
VERSE_DIAG(VG2106, "vm/ runtime raise: Subscribe on a `signal` no member binding names",
	"Subscribe was called on an unbound `signal`, which names nothing.")
VERSE_DIAG(VG2107, "vm/ runtime raise: Emit on an `event` that is not an @export_signal member",
	"Emit was called on an `event` that is not an `@export_signal` member of a class Godot "
	"instantiated, so it names no Godot signal. An event a script builds for itself is a Verse event "
	"and nothing more -- `Signal` is how tasks are resumed through one.")
VERSE_DIAG(VG2108, "vm/ runtime raise: Subscribe on an `event` that is not an @export_signal member",
	"Subscribe was called on an `event` that is not an `@export_signal` member of a class Godot "
	"instantiated, so it names no Godot signal.")
VERSE_DIAG(VG2109, "vm/ runtime raise: Await on a `signal` no member binding names",
	"Await was called on an unbound `signal`, which names nothing and so will never be emitted.")
VERSE_DIAG(VG2110, "vm/ runtime raise: Await on a signal_ref that names nothing",
	"Await was called on a Signal value that names no object and signal.")
VERSE_DIAG(VG2111, "vm/ runtime raise: Subscribe on a signal_ref that names nothing",
	"Subscribe was called on a Signal value that names no object and signal.")
VERSE_DIAG(VG2112, "vm/ runtime raise: Subscribe given a function that is not a bound method",
	"Subscribe was given a Verse function that is not a method bound to a live script instance, which "
	"is the only shape a Godot Callable can carry without outliving what it names.")
VERSE_DIAG(VG2113, "vm/ runtime error: an @export_signal event's delivery connection was refused",
	"The signal `{signal}` was registered but could not be connected, so awaiting it would never "
	"resume.")

// VG3xxx: `@rpc` configurations Godot is never given (R-EXP-9).
VERSE_DIAG(VG3001, "_validate warning and build log (VH_RPC_UNKNOWN_ARGUMENT)",
	"{name}: `{word}` is not an @rpc word. It must be one of \"call_local\"/\"call_remote\" (local "
	"calls), \"any_peer\"/\"authority\" (permission), or \"reliable\"/\"unreliable\"/"
	"\"unreliable_ordered\" (transfer mode).")
VERSE_DIAG(VG3002, "_validate warning and build log (VH_RPC_DUPLICATE_CATEGORY)",
	"{name}: {category} is given twice. Each of the three may be said no more than once.")
VERSE_DIAG(VG3003, "_validate warning and build log (VH_RPC_BAD_ARGUMENT_TYPE)",
	"{name}: @rpc wants {wanted} in this position.")

// VG4xxx: running, and loading the host. VG40xx is a Godot call Verse made that Godot refused.
VERSE_DIAG(VG4001, "vm/ runtime raise (VH_CALL_DEAD_OBJECT)",
	"{verb} `{member}` on Godot object {handle}, which Godot has already freed. Test "
	"IsInstanceValid[...] before reaching through a reference the scene may have dropped.")
VERSE_DIAG(VG4002, "vm/ runtime raise (VH_CALL_BAD_VALUE)",
	"{verb} `{member}` on Godot object {handle}, and the value has no representation on the Verse "
	"bridge. This is a gap in the type table in tools/gen_verse_api.py.")
VERSE_DIAG(VG4003, "vm/ runtime raise (VH_CALL_BAD_ARITY)",
	"{verb} `{member}` on Godot object {handle} with the wrong number of arguments. The generated Verse "
	"mirror and this build of Godot disagree; regenerate with tools/gen_verse_api.py.")
VERSE_DIAG(VG4004, "vm/ runtime raise (VH_CALL_NO_SUCH_MEMBER)",
	"{verb} `{member}` on Godot object {handle}, which has no such member. The generated Verse mirror "
	"and this build of Godot disagree; regenerate with tools/gen_verse_api.py.")
VERSE_DIAG(VG4005, "vm/ runtime raise: a container reference of 0",
	"{verb} a Godot container that names nothing. A container built in Verse -- `godot_array{}` and the "
	"like -- holds no Godot value; one has to come back from Godot.")
VERSE_DIAG(VG4006, "vm/ runtime raise: a container reference the ref table no longer holds",
	"{verb} a Godot container the bridge no longer holds (reference {ref}). A reference is released "
	"when the Verse value holding it is collected, so this is a handle kept past the object that owned "
	"it.")
VERSE_DIAG(VG4007, "vm/ runtime raise: a variant of a lane the declared type does not read",
	"Godot returned a value tagged {tag} where the Verse bridge expected `{expected}`. The type table in "
	"tools/gen_verse_api.py and this build of Godot disagree.")
VERSE_DIAG(VG4008, "vm/ runtime raise: a Godot call with no CallMethod callback installed",
	"Called `{member}` on Godot object {handle}, but this embedder cannot call Godot methods.")
VERSE_DIAG(VG4009, "vm/ runtime raise: a method call on a Godot value reference",
	"Godot has no method `{member}` on the value reference {ref} names.")
VERSE_DIAG(VG4010, "vm/ runtime raise: an archetype of a class Godot will not instantiate",
	"Godot would not make a `{class}`, so this class has no object to be. A Godot class that is "
	"abstract, or that the engine only ever hands out as a singleton, cannot be constructed -- derive "
	"from one that can, or reach the singleton through its accessor.")
VERSE_DIAG(VG4011, "vm/ runtime error: an entry point called off the thread Verse runs on (R-ASYNC-8)",
	"{entry} was called from a thread other than the one Verse runs on, so it did not run. Call it from "
	"the main thread.")

