.sconsign.dblite
__pycache__/
*.pyc

# scons intermediates
*.os
*.obj
*.o
*.lib
*.exp
*.pdb
*.ilk

# build outputs
bin/
build/
scratch/
demo/addons/*/bin/
dodge-the-creeps/addons/*/bin/
addons/*/bin/

# godot
.godot/
*.import
# The script icon's import options are load-bearing -- `convert_colors_with_editor_theme` is what
# keeps a white glyph visible on a light editor theme, and this file is where Godot reads it.
!**/addons/godot-verse/verse.svg.import

# unreal host build products
host/Intermediate/
custom.py
compile_commands.json

# local tooling
.claude/
.idea/

# the integration test project, generated by tools/run_tests.py
tests/integration/.godot/
tests/integration/addons/*/bin/
# The addon is copied in per run and its .gdextension generated from what was built, so the
# integration layer works with only an editor build and the export layer skips when the release
# library is absent. 4.7 writes a .uid beside what it copies, too.
tests/integration/addons/*/*.uid
tests/integration/addons/*/*.gdextension
