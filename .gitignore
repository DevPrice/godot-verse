.sconsign.dblite
__pycache__/
*.pyc

# scons intermediates
*.os
*.obj
*.o
*.lib
*.exp
*.pdb
*.ilk

# build outputs
bin/
build/
demo/addons/*/bin/
dodge-the-creeps/addons/*/bin/
addons/*/bin/

# godot
.godot/
*.import

# unreal host build products
host/Intermediate/
custom.py
compile_commands.json

# local tooling
.claude/
.idea/

# the integration test project, generated by tools/run_tests.py
tests/integration/.godot/
tests/integration/addons/*/bin/
# The addon itself is copied in per run, and 4.7 writes a .uid beside what it copies.
tests/integration/addons/*/*.uid
